# ==============================================================================
# FinPocket Backend Environment Configuration Template
# ==============================================================================
# Environment Mode: DEVELOPMENT | TEST | DEMO | STAGING | PRODUCTION
NODE_ENV=DEMO
PORT=3001

# JWT & Session Cryptography (In PRODUCTION, must be >= 32 random characters)
JWT_SECRET=replace_with_a_secure_minimum_32_character_random_string_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Cross-Origin Resource Sharing (CORS) - In PRODUCTION, MUST NOT be '*'
CORS_ORIGIN=http://localhost:3000

# Payment Limits Configuration
LIMIT_PER_TXN=25000.00
LIMIT_DAILY=50000.00
LIMIT_MONTHLY=200000.00

# Rate Limiting Controls (Window / Max Requests)
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_AUTH_MAX=15
RATE_LIMIT_PAYMENTS_MAX=30
RATE_LIMIT_AI_MAX=40

# Demo & Mock Flags (MUST be false in STAGING/PRODUCTION)
FINPOCKET_DEMO_MODE=true
FINPOCKET_ALLOW_MOCK_PROVIDER=true
FINPOCKET_DEMO_AUTO_LOGIN=true

# Database Connection (SQLite for local DEMO; PostgreSQL for STAGING/PRODUCTION)
DATABASE_URL=sqlite:./finpocket.db
# DATABASE_URL=postgresql://finpocket_user:secure_password@postgres.production.internal:5432/finpocket_prod?sslmode=require

# Logging
LOG_LEVEL=INFO
